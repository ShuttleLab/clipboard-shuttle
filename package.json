{
  "name": "clipboard-shuttle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "eslint",
    "wrangler:dev": "wrangler pages dev .vercel/output/static --compatibility-date=2026-01-01 --d1=DB=clipboard-d1-local",
    "wrangler:deploy": "wrangler pages deploy",
    "wrangler:login": "wrangler login",
    "d1:create": "wrangler d1 create clipboard-d1",
    "d1:migrate:local": "wrangler d1 execute clipboard-d1-local --local --file=./schema.sql",
    "d1:migrate:remote": "wrangler d1 execute clipboard-d1 --remote --file=./schema.sql",
    "preview": "npm run build:pages && npm run wrangler:dev"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^15.5.19",
    "qrcode.react": "^4.1.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^3.109.0"
  }
}
