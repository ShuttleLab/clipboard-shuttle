{
  "name": "clipboard-shuttle",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "wrangler pages deploy out",
    "start": "next start",
    "lint": "eslint",
    "dev:wrangler": "wrangler pages dev out --d1=DB=clipboard-d1-local",
    "wrangler:login": "wrangler login",
    "d1:create": "wrangler d1 create clipboard-d1",
    "d1:migrate:local": "wrangler d1 execute clipboard-d1-local --local --file=./schema.sql",
    "d1:migrate:remote": "wrangler d1 execute clipboard-d1 --remote --file=./schema.sql",
    "preview": "npm run build && npm run dev:wrangler"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.3.1",
    "qrcode.react": "^4.1.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^3.109.0"
  }
}
